# Required API bearer token.
API_TOKEN=change-me

# Cache/model locations.
HF_HOME=/home/ubuntu/.cache/huggingface
QWEN_ASR_TMP_DIR=/home/ubuntu/qwen-asr-cache/tmp

# Qwen3-ASR model routing.
QWEN_ASR_DEFAULT_MODEL=0.6b
QWEN_ASR_06B_MODEL=Qwen/Qwen3-ASR-0.6B
QWEN_ASR_17B_MODEL=Qwen/Qwen3-ASR-1.7B

# Driver 570.169 / RTX 5090: use stable qwen-asr[vllm], force Triton for
# language attention and SDPA for the audio encoder to avoid FlashAttention PTX
# failures on this driver.
QWEN_ASR_BACKEND=vllm
QWEN_ASR_DEVICE=cuda:0
QWEN_ASR_DTYPE=bfloat16
QWEN_ASR_GPU_MEMORY_UTILIZATION=0.35
QWEN_ASR_MAX_INFERENCE_BATCH_SIZE=32
QWEN_ASR_VLLM_MAX_MODEL_LEN=8192
QWEN_ASR_VLLM_ATTENTION_BACKEND=TRITON_ATTN
QWEN_ASR_VLLM_MM_ENCODER_ATTN_BACKEND=TORCH_SDPA
QWEN_ASR_VLLM_LIMIT_AUDIO_PER_PROMPT=1
QWEN_ASR_VLLM_ENFORCE_EAGER=0
QWEN_ASR_BATCH_MAX_WAIT_MS=50
QWEN_ASR_MAX_NEW_TOKENS=4096
QWEN_ASR_MAX_QUEUE_ITEMS=512
QWEN_ASR_REQUEST_TIMEOUT=600
QWEN_ASR_JOB_TTL_SECONDS=3600
QWEN_ASR_DEFAULT_CONTEXT=

# Timestamps require a third model; keep off until base ASR benchmark is stable.
QWEN_ASR_ENABLE_FORCED_ALIGNER=0
QWEN_ASR_FORCED_ALIGNER_MODEL=Qwen/Qwen3-ForcedAligner-0.6B

# Local smoke tests only.
QWEN_ASR_SKIP_MODEL_LOAD=0

LOG_LEVEL=INFO
PORT=6006
HOST=0.0.0.0
