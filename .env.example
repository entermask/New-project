API_TOKEN=change-me
HF_HOME=/home/ubuntu/.cache/huggingface
OMNIVOICE_CACHE_DIR=/home/ubuntu/omnivoice-cache
OMNIVOICE_GPU_PROFILE=auto
OMNIVOICE_DTYPE=fp16
OMNIVOICE_CONCURRENCY=6
OMNIVOICE_BATCH_SIZE=6
OMNIVOICE_BATCH_MAX_WAIT_MS=100
OMNIVOICE_BATCH_QUEUE_SIZE=256
OMNIVOICE_MAX_INFLIGHT_JOBS=20
OMNIVOICE_MAX_TEXT_CHARS=3000
OMNIVOICE_MODEL=k2-fsa/OmniVoice
OMNIVOICE_ASR_MODEL=openai/whisper-large-v3-turbo
OMNIVOICE_DEVICE=cuda:0
OMNIVOICE_ACCELERATION=base
OMNIVOICE_DOWNLOAD_TIMEOUT=60
OMNIVOICE_REQUEST_TIMEOUT=300
OMNIVOICE_ENABLE_BATCHING=1
LOG_LEVEL=INFO
