# Required API bearer token.
API_TOKEN=change-me

# Cache/model locations.
HF_HOME=/home/ubuntu/.cache/huggingface
OMNIVOICE_CACHE_DIR=/home/ubuntu/omnivoice-cache

# Model/runtime selection.
OMNIVOICE_MODEL=k2-fsa/OmniVoice
OMNIVOICE_ASR_MODEL=openai/whisper-large-v3
OMNIVOICE_DEVICE=cuda:0
OMNIVOICE_GPU_PROFILE=auto
OMNIVOICE_DTYPE=fp16
OMNIVOICE_ACCELERATION=triton

# Chunk scheduler.
# Split every accepted TTS task into text chunks around this size.
OMNIVOICE_CHUNK_SIZE_CHARS=200
# Maximum chunks sent to one model.generate(...) call.
OMNIVOICE_BATCH_SIZE=12
# New /v1/tts requests return 429 once queued+running chunks reach this level.
OMNIVOICE_BUSY_BACKLOG_CHUNKS=72
# Small wait to let short tasks fill a partial chunk batch.
OMNIVOICE_BATCH_MAX_WAIT_MS=15

# Network/job maintenance.
OMNIVOICE_DOWNLOAD_TIMEOUT=60
OMNIVOICE_REQUEST_TIMEOUT=300
OMNIVOICE_JOB_TTL_SECONDS=3600
OMNIVOICE_STREAMED_JOB_TTL_SECONDS=600
OMNIVOICE_JOB_CLEANUP_INTERVAL_SECONDS=600

# Local smoke tests only; set to 1 to skip loading OmniVoice and return silent audio.
OMNIVOICE_SKIP_MODEL_LOAD=0

LOG_LEVEL=INFO

# Server hosting configuration
PORT=6006
HOST=0.0.0.0
