# Required API bearer token.
API_TOKEN=change-me

# Cache/model locations. On GPUHub, keep heavy model cache on the system disk.
# Generated reference audio, job audio, and temp files go to the data disk.
HF_HOME=${HOME}/.cache/huggingface
OMNIVOICE_CACHE_DIR=${HOME}/autodl-tmp/omnivoice-cache
TMPDIR=${HOME}/autodl-tmp/tmp

# Model/runtime selection.
OMNIVOICE_MODEL=k2-fsa/OmniVoice
OMNIVOICE_DEVICE=cuda:0
OMNIVOICE_GPU_PROFILE=auto
OMNIVOICE_DTYPE=fp16
OMNIVOICE_ACCELERATION=triton

# Kokoro runtime. Preload/warmup is enabled by default to avoid first-request cold start.
KOKORO_MODEL=hexgrad/Kokoro-82M
KOKORO_DEVICE=cuda:0
KOKORO_CONCURRENCY=1
KOKORO_BUSY_BACKLOG_CHUNKS=72
KOKORO_PRELOAD=1
KOKORO_PRELOAD_LANGUAGES=a,b,e,f,h,i,j,p,z
KOKORO_WARMUP=1

# Chunk scheduler.
OMNIVOICE_CHUNK_SIZE_CHARS=200
OMNIVOICE_BATCH_SIZE=12
OMNIVOICE_BUSY_BACKLOG_CHUNKS=72
OMNIVOICE_BATCH_MAX_WAIT_MS=15
OMNIVOICE_STREAM_CHUNK_SIZE_BYTES=1048576

# Network/job maintenance.
OMNIVOICE_DOWNLOAD_TIMEOUT=60
OMNIVOICE_REQUEST_TIMEOUT=300
OMNIVOICE_JOB_TTL_SECONDS=3600
OMNIVOICE_STREAMED_JOB_TTL_SECONDS=600
OMNIVOICE_JOB_CLEANUP_INTERVAL_SECONDS=600

# Local smoke tests only.
OMNIVOICE_SKIP_MODEL_LOAD=0

LOG_LEVEL=INFO
PORT=6006
HOST=0.0.0.0
