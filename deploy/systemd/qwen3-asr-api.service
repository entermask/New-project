[Unit]
Description=Qwen3 ASR API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/omnivoice-api
EnvironmentFile=/home/ubuntu/omnivoice-api/.env
ExecStart=/home/ubuntu/omnivoice-api/scripts/run_stt.sh
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
