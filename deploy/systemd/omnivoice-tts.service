[Unit]
Description=OmniVoice TTS API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/omnivoice-api
EnvironmentFile=/home/ubuntu/omnivoice-api/.env
ExecStart=/home/ubuntu/venvs/omnivoice-tts/bin/uvicorn omnivoice_api.tts.server:app --host 0.0.0.0 --port 6006
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
