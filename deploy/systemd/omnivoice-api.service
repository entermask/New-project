[Unit]
Description=OmniVoice API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/omnivoice-api
EnvironmentFile=/home/ubuntu/omnivoice-api/.env
ExecStart=/home/ubuntu/venvs/omnivoice-api/bin/uvicorn app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
